[Unit]
Description=SIPVoice AI Voice Agent
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=sipvoice
Group=sipvoice
ExecStart=/opt/sipvoice/voicebridge -mode agent -config /etc/sipvoice/config.json -web 0.0.0.0:8080
Environment="PATH=/opt/edge-tts/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Restart=always
RestartSec=3
# 日志走 journald：journalctl -u sipvoice -f
StandardOutput=journal
StandardError=journal

# 基础加固
PrivateTmp=yes
ProtectSystem=full
# 注：ReadWritePaths 里列出的路径必须真实存在，否则 systemd 会以
# status=226/NAMESPACE 拒绝启动。install.sh 会按实际录音目录重写这一行，
# 这里只保留任何环境下都存在的路径。
ReadWritePaths=/etc/sipvoice /opt/sipvoice/models /etc/asterisk /etc/default /etc/logrotate.d /var/log/asterisk /var/spool/asterisk /var/lib/sipvoice
ProtectHome=yes

[Install]
WantedBy=multi-user.target
